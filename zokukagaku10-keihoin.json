  {
   "id": "zokukagaku10-keihoin-0004",
   "pid": "993388",
   "pages": [
    241
   ],
   "text": "四百六十四とき浅とて思ひ知らおむよ北中お心なグきい悔しりりりりとぶ鳥比翅お似さる友もらをおもひろはして立居くらさむ人の上に見れが短ろきよ北中もときおい長くおもほゆる哉さめて後あゝろふうりぶ古·へい又も夢〓るあゝちおそもき祝大江山むりしがさり成幼子のねふりの友となせる御代りを肥後守景樹久しうわづらひて終ふむなしく成ぬる由きゝてめの前お見えぞなりゆく敷嶋の道を近しとなふさのミクむ春懷舊いつまでり昔比人をよぶお鳥よべどおさふる山びあもなし夜懷舊なき人の夢に比〓あそ見えふりき夜い昔ふ近くやあるらむ墓こゝお來てうき世比人も思ひ玄き木おも石おも何り殘らむ大原比おく寂光院といへる寺おしるよしありて吾身をりらむ後の事など賴〓おきてか北汀比櫻てふ木の本あしるし北石文あいきゑりるふかいつゆるるうづもるゝ身ハ露玄ものふる塚も春ざふ花の雪ふかくれむ桂芳院遺草終",
   "poems": [
    "60",
    "61",
    "62",
    "63",
    "64",
    "65",
    "66",
    "67",
    "68",
    "69"
   ],
   "lb": []
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "うぐひも比聲や氷おひヾくらむ音さてそめつ谷がはの〓づづ",
   "kana": "",
   "speaker": "",
   "page": 238,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "ふきもさぶ風の心もよ〓るらむ柳比いと北おびくもグさお",
   "kana": "",
   "speaker": "",
   "page": 238,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "つれ〓〓と昔比はる比あひしきお心をさへもぬらも雨りな",
   "kana": "",
   "speaker": "",
   "page": 238,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "いそぎても歸る膓りお越路おいさくらわまさる花や咲らむ",
   "kana": "",
   "speaker": "",
   "page": 238,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "人めなきよもぎグ庭の一もとも我世の春とはなさきにりり",
   "kana": "",
   "speaker": "",
   "page": 238,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "春來ぬと今日く〓そむる若水の若き身いりに嬉しりるらむ",
   "kana": "",
   "speaker": "",
   "page": 238,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "大のさ比野山の外ふさなびくい心比うち北かもミなりろま",
   "kana": "",
   "speaker": "",
   "page": 238,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "おしをべて梅の盛お成ぬきバ野あも山にもうぐひもの嗚く",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "花ミおと夜ごめおいでし曙北山のりしき比めづらしきりむ",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "もとれ草はやゆきてつめ足引の春比山田いいまりへもおり",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "たゞひとりゆきても見ばや夕月に蛙なくらむ賀茂比河原を",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "ともらきぬかさそい露ふれこりろりきえし昔比撫子比はな",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "若苗のなグるゝ〓とバ谷川比おく比山田もいまや植うらむ",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "さま〓〓の草い茂れど小山田北さ苗ふ似さる色なうりりりり",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "罪各をはらへつくして歸るさい身さへかろくも思やゆる哉",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "てらも日お末葉よらもてませ垣比萩さへいまざ知らぬ秋哉",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "ひこ星のあふこよひなり久方の天の川ぎりさちなへどてそ",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "天比川あふ瀨い明日比うきせとも思ひ知らぞや船渡すらむ",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "そ北昔ひと夜と星比契りしや空あも比思ふはじめなどりむ",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "かつさりが人おをらきて道北べ比萩ハ盛おならむ日もなし",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "露の身い消て〓後も草れはら友と聞くベきた〓〓〓もりな",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "よのなりい星比林のあと玄どき中にももめバを免る月りな",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "つく〓〓と見をバ悲しく成おろり面白うりし月のりしきも",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "身にも玄ミ骨みも玄ミぬ長月比去年のあよひ比有明のあゆ",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "淺まじ升花のもグさや女郞花世をあき風おちりもはてなで",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "ひとり見る秋比月夜によびつれてあまさも雁比鳴渡るりな",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "此ゆふべ時雨にぬれてゆく秋いとりさの山や宿りなるらむ",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "夕風ふなくひよどりの聲おちて日かゆさびしき杉の一むら",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "きり〓〓もされむかゆなる一本の薄もいさく霜ぞおきりる",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "玄らゆき〓花とも見しいそおむろし花なる時北心なりりま",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "手〓折て何のかぞへむ中垣のとなりまでこそ春い來おりを",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "夕べ〓〓木葉ふる音わびしきお紅葉もる本い植じとぞ思ふ",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "かしの實い今り落らむ此もり北かゆなる河ふをしぞ鳴なる",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "朝日さす松よりおつる白雪れやと〓〓〓れれも消ぬべらなり",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "ありつき北くらきまぎもふ歸なむヨグ泣し顔人のみぬまお",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "聲きりがいでもやくると松虫成垣比ひまより放ちいきつる",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "中々にあびしくのみぞおりまさる櫻のはなも君と見てあそ",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "むらぎも比心ひとつお思ふあと命のうちおいふひまもグな",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "悲しくもみゆる夢クないうふして打ぬる間ざお君を忘きむ",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "〓とばりり千夜ふ見る夢一夜ざお君グ夢おもみえよとぞ思ふ",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "淺うらぞ契ると見えし夢比うちの人い人ふて玄らぞ顏なる",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "よな〓〓おあふとみゆるハ夢なれどさもグふ絕ぬ心地こそもれ",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "語るべくいふべくもなき夢とれが覺ての後ぞ詠められける",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "之〓山も端山も〓〓〓バ〓〓つつし戀の奧こそ道なりりろせ",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "增鏡むりふ〓まさへうき影成とりてい君おみえじとぞ思ふ",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "雨のおとも心細くぞきあえりる空もあよひや寐覺しつらむ",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "おしをべて雨比音とも思ひらりふるああさふる物比響き找",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "おとご川おグき〓〓て末つひふ底のみくづと成ぬべらなり",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "かりそめ北とグ山ぞ〓も年ふりぬ植し杉H實垣ふなるまで",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "うきふしお色も變らぬ竹のよを人のよおして見る由もグを",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "君ゆりが歸らむ日までよ北中ふ花も紅葉もあらじとぞ思ふ",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "きミグ舟はるうおおりぬ波風も今いなさちそとめむ由なし",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "すみはてぬ旅の中をる旅なをバ世をろり枕をおりいとはむ",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "武藏野も今日山の端ハ見えそめつ我旅路おそ果なりりりき",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "身一つをうき世と思ひし昔あそうき世を知らぬ昔なり々き",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "葛かづら繁きる谷の隱を松のくても千代をふるいふるかい",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "何おかく心〓じろく歎くらむ千代までたてる松もありろま",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "よの中の人の誠n玄さしきおうときふよらぬ物ふざりるる",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "玄さしきいいつも親しく思ふあそ憂世を知らぬ心なまけき",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "とき浅とて思ひ知らおむよ北中お心なグきい悔しりりりり",
   "kana": "",
   "speaker": "",
   "page": 241,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "とぶ鳥比翅お似さる友もらをおもひろはして立居くらさむ",
   "kana": "",
   "speaker": "",
   "page": 241,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "人の上に見れが短ろきよ北中もときおい長くおもほゆる哉",
   "kana": "",
   "speaker": "",
   "page": 241,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "さめて後あゝろふうりぶ古·へい又も夢〓るあゝちおそもき",
   "kana": "",
   "speaker": "",
   "page": 241,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "大江山むりしがさり成幼子のねふりの友となせる御代りを",
   "kana": "",
   "speaker": "",
   "page": 241,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "めの前お見えぞなりゆく敷嶋の道を近しとなふさのミクむ",
   "kana": "",
   "speaker": "",
   "page": 241,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "いつまでり昔比人をよぶお鳥よべどおさふる山びあもなし",
   "kana": "",
   "speaker": "",
   "page": 241,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "なき人の夢に比〓あそ見えふりき夜い昔ふ近くやあるらむ",
   "kana": "",
   "speaker": "",
   "page": 241,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "こゝお來てうき世比人も思ひ玄き木おも石おも何り殘らむ",
   "kana": "",
   "speaker": "",
   "page": 241,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "うづもるゝ身ハ露玄ものふる塚も春ざふ花の雪ふかくれむ",
   "kana": "",
   "speaker": "",
   "page": 241,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  }
 ],
 "catalog": {
